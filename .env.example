# DeepSeek API（必填；真实值写入 .env，.env 不提交 Git）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 以 DeepSeek 官方文档当前模型名为准
DEEPSEEK_MODEL=deepseek-v4-flash

# 策略比较接口的本地演示令牌(JSON);生产环境应替换为真实认证上下文
DEMO_ROLE_TOKENS={"employee":"replace-employee-token","engineer":"replace-engineer-token","hr":"replace-hr-token","admin":"replace-admin-token"}

# Qdrant（本地 Docker Compose 启动）
QDRANT_URL=http://localhost:6333

# HuggingFace 下载端点：国内镜像，免代理；若网络可直连 huggingface.co 可移除此行
HF_ENDPOINT=https://hf-mirror.com

# HuggingFace 缓存根目录（模型冻结位置；.env 兜底，防止旧终端读不到用户级 HF_HOME）
HF_HOME=D:\DevelopmentTools\hf-cache

# 策略比较 Agent 护栏（只读工具循环）
AGENT_MAX_STEPS=4
AGENT_MAX_TOOL_CALLS=3
AGENT_TIMEOUT_SECONDS=20
