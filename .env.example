# DeepSeek API（必填；真实值写入 .env，.env 不提交 Git）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 以 DeepSeek 官方文档当前模型名为准
DEEPSEEK_MODEL=deepseek-v4-flash

# 本地工作台、Swagger 与测试的演示令牌(JSON)；生产环境应替换为真实认证上下文。
# approver 仅用于独立的受控操作审批；未演示审批时可省略该角色。
DEMO_ROLE_TOKENS={"employee":"replace-employee-token","engineer":"replace-engineer-token","hr":"replace-hr-token","admin":"replace-admin-token","approver":"replace-approver-token"}

# Qdrant（本地 Docker Compose 启动）
QDRANT_URL=http://localhost:6333
QDRANT_V2_COLLECTION=kb_chunks_v2
EMBEDDING_DIM=1024

# PostgreSQL 是业务、任务和证据的唯一事实源。不要提交真实口令。
DATABASE_URL=postgresql+psycopg://rag_kb:replace-password@localhost:5432/rag_kb
POSTGRES_PASSWORD=replace-local-compose-password

# 对象根目录只接受服务端生成键；API 与 worker 必须共享此目录。
OBJECT_STORE_ROOT=./data/local/objects

# HuggingFace 下载端点：国内镜像，免代理；若网络可直连 huggingface.co 可移除此行
HF_ENDPOINT=https://hf-mirror.com

# HuggingFace 宿主机缓存根目录。Docker API/worker 会只读挂载此目录，避免重复下载模型。
# 路径必须已经包含完整的 hub/models--BAAI--bge-m3 快照。
HF_HOME=D:\DevelopmentTools\hf-cache

# 检索参数：Docker Compose 未设置候选池时默认 20；上下文未设置时回落到 TOP_K。
# 非 Compose 运行时，候选池和上下文均会回落到 TOP_K。
RETRIEVAL_TOP_K=5
# RETRIEVAL_CANDIDATE_K=20
# RETRIEVAL_CONTEXT_K=5
# RETRIEVAL_SCORE_THRESHOLD=
RETRIEVAL_CONTEXT_TOKEN_BUDGET=4000
RETRIEVAL_RRF_K=60
ENABLE_HYBRID_RETRIEVAL=false

# Research Agent 护栏（只读工具循环）
AGENT_MAX_MODEL_CALLS=12
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_RUNTIME_SECONDS=600
AGENT_TIMEOUT_SECONDS=20
AGENT_CAPABILITY_LEASE_SECONDS=30
TASK_AGENT_CAPABILITY_NAME=task-agent
TASK_AGENT_PROTOCOL_VERSION=m2-fenced-v1
LANGGRAPH_STRICT_MSGPACK=true
ENABLE_CONTROLLED_ACTION_TASKS=true

# Research 正文保留：API 与 Worker 必须共享；孤儿宽限期必须大于单次工具超时。
TOOL_RESULT_TTL_SECONDS=604800
TASK_RESULT_RETENTION_DAYS=7
RESULT_OBJECT_ORPHAN_GRACE_SECONDS=3600
