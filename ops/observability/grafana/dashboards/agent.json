{
  "uid": "rag-kb-agent",
  "title": "RAG KB / Agent",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "type": "timeseries",
      "title": "Claimed task terminal outcomes",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (mode, outcome) (rate(rag_kb_task_runs_total[5m]))", "legendFormat": "run {{mode}} {{outcome}}", "refId": "A"},
        {"expr": "sum by (mode, result) (rate(rag_kb_task_claims_total[5m]))", "legendFormat": "claim {{mode}} {{result}}", "refId": "B"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Agent LLM calls and P95 duration",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (outcome) (rate(rag_kb_llm_calls_total{operation=\"agent.generate\"}[5m]))", "legendFormat": "{{outcome}} calls/s", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(rag_kb_llm_call_duration_seconds_bucket{operation=\"agent.generate\"}[5m])))", "legendFormat": "{{outcome}} p95", "refId": "B"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Tool success and timeout ratios",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum(rate(rag_kb_tool_calls_total{outcome=\"succeeded\"}[5m])) / clamp_min(sum(rate(rag_kb_tool_calls_total[5m])), 0.001)", "legendFormat": "success ratio", "refId": "A"},
        {"expr": "sum(rate(rag_kb_tool_calls_total{error_category=\"timeout\"}[5m])) / clamp_min(sum(rate(rag_kb_tool_calls_total[5m])), 0.001)", "legendFormat": "timeout ratio", "refId": "B"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "type": "timeseries",
      "title": "Approval transitions",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (decision, outcome) (rate(rag_kb_approvals_total[5m]))", "legendFormat": "{{decision}} {{outcome}}", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    },
    {
      "type": "timeseries",
      "title": "Approval wait P95",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, decision) (rate(rag_kb_approval_wait_duration_seconds_bucket[5m])))", "legendFormat": "{{decision}} p95", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
    },
    {
      "type": "timeseries",
      "title": "Checkpoint and lease outcomes",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (outcome) (rate(rag_kb_checkpoint_writes_total[5m]))", "legendFormat": "checkpoint {{outcome}}/s", "refId": "A"},
        {"expr": "sum by (kind, operation) (rate(rag_kb_lease_failures_total[5m]))", "legendFormat": "{{kind}} {{operation}} failures/s", "refId": "B"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
    },
    {
      "type": "timeseries",
      "title": "Task queue depth",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (mode, status) (rag_kb_task_queue_depth)", "legendFormat": "{{mode}} {{status}}", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24}
    },
    {
      "type": "timeseries",
      "title": "Task queue oldest age",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "max by (mode, status) (rag_kb_task_queue_oldest_age_seconds)", "legendFormat": "{{mode}} {{status}}", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}
    }
  ]
}
