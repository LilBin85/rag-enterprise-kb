{
  "uid": "rag-kb-system",
  "title": "RAG KB / System Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "type": "stat",
      "title": "API up",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "up{job=\"rag-kb-api\"}", "refId": "A"}],
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}
    },
    {
      "type": "stat",
      "title": "Worker up",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "up{job=\"rag-kb-worker\"}", "refId": "A"}],
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "HTTP request rate and 5xx",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum(rate(rag_kb_http_requests_total[5m]))", "legendFormat": "requests/s", "refId": "A"},
        {"expr": "sum(rate(rag_kb_http_requests_total{status_class=\"5xx\"}[5m]))", "legendFormat": "5xx/s", "refId": "B"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "HTTP P95 duration",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(rag_kb_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    }
  ]
}
