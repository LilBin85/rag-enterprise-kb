{
  "uid": "rag-kb-ingestion-projection",
  "title": "RAG KB / Ingestion and Projection",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "type": "timeseries",
      "title": "Ingestion queue depth",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "rag_kb_ingestion_queue_depth", "legendFormat": "{{status}}", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Ingestion queue oldest age",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "max by (status) (rag_kb_ingestion_queue_oldest_age_seconds)", "legendFormat": "{{status}}", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Ingestion phase duration quantiles",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le, phase) (rate(rag_kb_ingestion_phase_duration_seconds_bucket[5m])))", "legendFormat": "{{phase}} p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le, phase) (rate(rag_kb_ingestion_phase_duration_seconds_bucket[5m])))", "legendFormat": "{{phase}} p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le, phase) (rate(rag_kb_ingestion_phase_duration_seconds_bucket[5m])))", "legendFormat": "{{phase}} p99", "refId": "C"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "type": "timeseries",
      "title": "Ingestion job retries and outcomes",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (phase, outcome) (rate(rag_kb_ingestion_jobs_total[5m]))", "legendFormat": "{{phase}} {{outcome}}", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    },
    {
      "type": "timeseries",
      "title": "Projection audit/reconcile outcomes",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (phase, outcome) (rate(rag_kb_projection_reconciliations_total[5m]))", "legendFormat": "{{phase}} {{outcome}}", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
    },
    {
      "type": "timeseries",
      "title": "Projection duration P50/P95/P99",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le, phase) (rate(rag_kb_projection_reconcile_duration_seconds_bucket[5m])))", "legendFormat": "{{phase}} p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le, phase) (rate(rag_kb_projection_reconcile_duration_seconds_bucket[5m])))", "legendFormat": "{{phase}} p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le, phase) (rate(rag_kb_projection_reconcile_duration_seconds_bucket[5m])))", "legendFormat": "{{phase}} p99", "refId": "C"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
    },
    {
      "type": "timeseries",
      "title": "Unconverged projection proxy (retry/failure, 10m)",
      "description": "Honest proxy: at least two retry/failure events and no successful reconciliation in 10 minutes; no unconverged gauge exists.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "rag_kb:projection_unconverged_proxy:10m", "legendFormat": "proxy", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24}
    },
    {
      "type": "timeseries",
      "title": "Recovery action outcomes",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (kind, outcome) (rate(rag_kb_recovery_actions_total[5m]))", "legendFormat": "{{kind}} {{outcome}}", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}
    }
  ]
}
