{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAG 企业知识库智能体项目验收报告",
  "type": "object",
  "required": [
    "schema_version",
    "generated_on",
    "standard",
    "evidence_levels",
    "verdict",
    "mandatory_gates",
    "scorecard",
    "metrics",
    "evidence_artifacts",
    "reproducibility",
    "known_limits"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_on": { "type": "string", "format": "date" },
    "standard": {
      "type": "object",
      "required": ["name", "target_score", "mandatory_rule"],
      "properties": {
        "name": { "const": "应届生 AI Agent/RAG 强主项目" },
        "target_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "mandatory_rule": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "evidence_levels": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/evidence_level_definition" }
    },
    "verdict": {
      "type": "object",
      "required": ["status", "score", "max_score", "grade", "overall_evidence_level", "mandatory_gates_passed"],
      "properties": {
        "status": { "enum": ["passed", "failed"] },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "max_score": { "const": 100 },
        "grade": { "type": "string", "minLength": 1 },
        "overall_evidence_level": { "$ref": "#/$defs/evidence_level" },
        "mandatory_gates_passed": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "mandatory_gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gate" }
    },
    "scorecard": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/score_item" }
    },
    "metrics": {
      "type": "object",
      "required": ["planner_live_11x3", "planner_live_smoke_4x1", "planner_deterministic_contract", "retrieval_real", "test_suite"],
      "properties": {
        "planner_live_11x3": { "$ref": "#/$defs/planner_metrics" },
        "planner_live_smoke_4x1": { "$ref": "#/$defs/planner_metrics" },
        "planner_deterministic_contract": { "$ref": "#/$defs/contract_metrics" },
        "retrieval_real": { "$ref": "#/$defs/retrieval_metrics" },
        "test_suite": { "$ref": "#/$defs/test_metrics" }
      },
      "additionalProperties": false
    },
    "evidence_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "reproducibility": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reproduction" }
    },
    "known_limits": {
      "type": "array",
      "items": { "$ref": "#/$defs/known_limit" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "evidence_level": { "enum": ["C0", "C1", "C2", "C3"] },
    "evidence_level_definition": {
      "type": "object",
      "required": ["level", "definition"],
      "properties": {
        "level": { "$ref": "#/$defs/evidence_level" },
        "definition": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": ["name", "passed", "evidence_level", "evidence"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "evidence_level": { "$ref": "#/$defs/evidence_level" },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "score_item": {
      "type": "object",
      "required": ["dimension", "score", "max_score", "evidence_level", "basis"],
      "properties": {
        "dimension": { "type": "string", "minLength": 1 },
        "score": { "type": "integer", "minimum": 0 },
        "max_score": { "type": "integer", "minimum": 1 },
        "evidence_level": { "$ref": "#/$defs/evidence_level" },
        "basis": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "planner_metrics": {
      "type": "object",
      "required": ["case_count", "repetitions", "completed_runs", "passed_runs", "safety_gates", "quality_gates", "cost_gates", "terminal_state_valid", "task_outcome_correct", "plan_constraint_pass", "exact_control_trace_match", "first_pass_plan_success_rate", "repair_rate", "emergency_fallback_rate"],
      "properties": {
        "case_count": { "type": "integer", "minimum": 1 },
        "repetitions": { "type": "integer", "minimum": 1 },
        "completed_runs": { "type": "integer", "minimum": 1 },
        "passed_runs": { "type": "integer", "minimum": 0 },
        "safety_gates": { "type": "boolean" },
        "quality_gates": { "type": "boolean" },
        "cost_gates": { "type": "boolean" },
        "terminal_state_valid": { "type": "number", "minimum": 0, "maximum": 1 },
        "task_outcome_correct": { "type": "number", "minimum": 0, "maximum": 1 },
        "plan_constraint_pass": { "type": "number", "minimum": 0, "maximum": 1 },
        "clarification_answer_utilization": { "type": "number", "minimum": 0, "maximum": 1 },
        "acl_leakage_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "unexpected_budget_exhaustion_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "exact_control_trace_match": { "type": "number", "minimum": 0, "maximum": 1 },
        "exact_path_diagnostic": { "type": "number", "minimum": 0, "maximum": 1 },
        "first_pass_plan_success_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "repair_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "emergency_fallback_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "model_decisions": { "type": "integer", "minimum": 0 },
        "executed_searches": { "type": "integer", "minimum": 0 },
        "repairs": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "token_metadata_missing_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "contract_metrics": {
      "type": "object",
      "required": ["sample_size", "safety_gates", "quality_gates", "cost_gates"],
      "properties": {
        "sample_size": { "type": "integer", "minimum": 1 },
        "safety_gates": { "type": "boolean" },
        "quality_gates": { "type": "boolean" },
        "cost_gates": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "retrieval_metrics": {
      "type": "object",
      "required": ["backend", "model", "calibration_cases", "test_cases", "selected_score_threshold", "recall_at_5", "mrr", "ndcg_at_5", "exact_term_recall_at_5", "correct_version_recall_at_5", "acl_filtered_recall_at_5", "no_answer_accuracy", "acl_leak_rate", "quality_gates", "isolated_collection_cleanup"],
      "properties": {
        "backend": { "type": "string" },
        "model": { "type": "string" },
        "calibration_cases": { "type": "integer", "minimum": 1 },
        "test_cases": { "type": "integer", "minimum": 1 },
        "selected_score_threshold": { "type": "number" },
        "recall_at_5": { "type": "number", "minimum": 0, "maximum": 1 },
        "mrr": { "type": "number", "minimum": 0, "maximum": 1 },
        "ndcg_at_5": { "type": "number", "minimum": 0, "maximum": 1 },
        "exact_term_recall_at_5": { "type": "number", "minimum": 0, "maximum": 1 },
        "correct_version_recall_at_5": { "type": "number", "minimum": 0, "maximum": 1 },
        "acl_filtered_recall_at_5": { "type": "number", "minimum": 0, "maximum": 1 },
        "no_answer_accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
        "acl_leak_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "quality_gates": { "type": "boolean" },
        "isolated_collection_cleanup": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "test_metrics": {
      "type": "object",
      "required": ["passed", "failed", "duration_seconds"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "duration_seconds": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["name", "path", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "reproduction": {
      "type": "object",
      "required": ["name", "command", "requires_external_service", "expected_result"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "requires_external_service": { "type": "boolean" },
        "expected_result": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "known_limit": {
      "type": "object",
      "required": ["id", "priority", "status", "detail"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["P1", "P2"] },
        "status": { "enum": ["open", "observed", "mitigated"] },
        "detail": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
