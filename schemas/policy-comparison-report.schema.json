{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Policy comparison benchmark report",
  "type": "object",
  "required": ["schema_version", "manifest", "sample_size", "metrics", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "manifest": {"type": "string"},
    "sample_size": {"type": "integer", "minimum": 0},
    "metrics": {
      "type": "object",
      "required": ["case_pass", "acl_leakage_count", "version_mismatch", "citation_integrity", "guardrail_violations", "refusal_incorrect_count"],
      "additionalProperties": {"type": "number", "minimum": 0}
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "duration_ms", "metrics"],
        "properties": {
          "name": {"type": "string"},
          "status": {"enum": ["pass", "fail"]},
          "duration_ms": {"type": "number", "minimum": 0},
          "metrics": {"type": "object"}
        }
      }
    }
  },
  "additionalProperties": false
}
