{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rag-kb.local/schemas/retrieval-acceptance-report.schema.json",
  "title": "真实检索验收报告 v2",
  "type": "object",
  "required": [
    "schema_version", "created_at", "status", "backend", "dataset",
    "thresholds", "parameter_search", "collection_cleanup"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "created_at": { "type": "string", "format": "date-time" },
    "status": {
      "enum": [
        "running", "passed", "quality_gates_failed",
        "calibration_quality_gates_failed", "test_quality_gates_failed",
        "selected_configuration_replay_mismatch",
        "label_validation_failed", "run_failed"
      ]
    },
    "backend": { "$ref": "#/$defs/backend" },
    "dataset": { "$ref": "#/$defs/dataset" },
    "thresholds": { "$ref": "#/$defs/thresholds" },
    "parameter_search": { "$ref": "#/$defs/parameter_search" },
    "collection_cleanup": { "$ref": "#/$defs/collection_cleanup" },
    "ingestion": { "$ref": "#/$defs/ingestion" },
    "gold_label_validation": { "$ref": "#/$defs/gold_label_validation" },
    "threshold_calibration": { "$ref": "#/$defs/threshold_calibration" },
    "calibration": { "$ref": "#/$defs/evaluation_with_gates" },
    "test": { "$ref": "#/$defs/evaluation_with_gates" },
    "all_cases": { "$ref": "#/$defs/evaluation" },
    "selected_configuration_replay": { "$ref": "#/$defs/selected_configuration_replay" },
    "costs": { "$ref": "#/$defs/costs" },
    "error_code": { "type": "string", "minLength": 1, "maxLength": 200 }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "passed", "quality_gates_failed",
              "calibration_quality_gates_failed", "test_quality_gates_failed",
              "selected_configuration_replay_mismatch"
            ]
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": [
          "ingestion", "gold_label_validation", "threshold_calibration",
          "calibration", "test", "all_cases",
          "selected_configuration_replay", "costs"
        ]
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "label_validation_failed" } },
        "required": ["status"]
      },
      "then": { "required": ["ingestion", "gold_label_validation"] }
    },
    {
      "if": {
        "properties": { "status": { "const": "run_failed" } },
        "required": ["status"]
      },
      "then": { "required": ["error_code"] }
    },
    {
      "if": {
        "properties": { "status": { "const": "passed" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "collection_cleanup": {
            "properties": {
              "attempted": { "const": true },
              "succeeded": { "const": true }
            }
          },
          "threshold_calibration": {
            "properties": {
              "quality_gates": {
                "properties": { "passed": { "const": true } }
              }
            }
          },
          "calibration": {
            "properties": {
              "quality_gates": {
                "properties": { "passed": { "const": true } }
              }
            }
          },
          "test": {
            "properties": {
              "quality_gates": {
                "properties": { "passed": { "const": true } }
              }
            }
          },
          "selected_configuration_replay": {
            "properties": { "passed": { "const": true } }
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "ratio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "nonnegative_number": { "type": ["number", "null"], "minimum": 0 },
    "count_map": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "backend": {
      "type": "object",
      "required": [
        "mode", "model", "qdrant_url", "isolated_collection",
        "embedding_batch_size", "acl_filter", "retrieval_order",
        "query_execution", "raw_candidate_k"
      ],
      "properties": {
        "mode": { "const": "real_bge_m3_qdrant" },
        "model": { "type": "string", "minLength": 1 },
        "qdrant_url": { "type": "string", "minLength": 1 },
        "isolated_collection": { "type": "string", "minLength": 1 },
        "embedding_batch_size": {
          "type": ["string", "integer"],
          "minLength": 1,
          "minimum": 0
        },
        "acl_filter": {
          "const": "status=active AND allowed_roles contains role"
        },
        "retrieval_order": {
          "const": "qdrant_server_acl -> candidate_k -> score_threshold -> context_k"
        },
        "query_execution": {
          "const": "sequential_production_retriever_search"
        },
        "raw_candidate_k": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "dataset": {
      "type": "object",
      "required": [
        "path", "name", "total_cases", "split_counts", "category_counts",
        "required_top_k", "frozen_baseline_context_k"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "total_cases": { "type": "integer", "minimum": 1 },
        "split_counts": { "$ref": "#/$defs/count_map" },
        "category_counts": { "$ref": "#/$defs/count_map" },
        "required_top_k": { "type": "integer", "minimum": 1 },
        "frozen_baseline_context_k": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "thresholds": {
      "type": "object",
      "required": [
        "recall_at_k", "mrr", "ndcg_at_k", "correct_version_recall_at_k",
        "exact_term_recall_at_k", "acl_filtered_recall_at_k",
        "no_answer_accuracy", "acl_leak_rate"
      ],
      "properties": {
        "recall_at_k": { "type": "number", "minimum": 0, "maximum": 1 },
        "mrr": { "type": "number", "minimum": 0, "maximum": 1 },
        "ndcg_at_k": { "type": "number", "minimum": 0, "maximum": 1 },
        "correct_version_recall_at_k": { "type": "number", "minimum": 0, "maximum": 1 },
        "exact_term_recall_at_k": { "type": "number", "minimum": 0, "maximum": 1 },
        "acl_filtered_recall_at_k": { "type": "number", "minimum": 0, "maximum": 1 },
        "no_answer_accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
        "acl_leak_rate": { "const": 0.0 }
      },
      "additionalProperties": false
    },
    "parameter_search": {
      "type": "object",
      "required": [
        "selection_split", "test_labels_used_for_selection",
        "candidate_k_values", "context_k_values",
        "raw_candidate_pool_executions_per_case",
        "selected_configuration_replay_executions_per_case",
        "production_configuration_changed"
      ],
      "properties": {
        "selection_split": { "const": "calibration" },
        "test_labels_used_for_selection": { "const": false },
        "candidate_k_values": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "context_k_values": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "raw_candidate_pool_executions_per_case": { "const": 1 },
        "selected_configuration_replay_executions_per_case": { "const": 1 },
        "production_configuration_changed": { "const": false }
      },
      "additionalProperties": false
    },
    "collection_cleanup": {
      "type": "object",
      "required": ["attempted", "succeeded"],
      "properties": {
        "attempted": { "type": "boolean" },
        "succeeded": { "type": "boolean" },
        "error_code": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "additionalProperties": false
    },
    "ingestion": {
      "type": "object",
      "required": ["documents"],
      "properties": {
        "documents": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["document_id", "version", "chunk_count", "previous_version"],
            "properties": {
              "document_id": { "type": "string", "minLength": 1 },
              "version": { "type": "integer", "minimum": 1 },
              "chunk_count": { "type": "integer", "minimum": 0 },
              "previous_version": { "type": ["integer", "null"], "minimum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "gold_label_validation": {
      "type": "object",
      "required": [
        "passed", "active_chunk_count", "ingested_chunk_count",
        "error_count", "errors"
      ],
      "properties": {
        "passed": { "type": "boolean" },
        "active_chunk_count": { "type": "integer", "minimum": 0 },
        "ingested_chunk_count": { "type": "integer", "minimum": 0 },
        "error_count": { "type": "integer", "minimum": 0 },
        "errors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": [
        "case_count", "positive_case_count", "no_answer_case_count",
        "exact_term_case_count", "acl_positive_case_count",
        "acl_denied_case_count", "recall_at_k", "mrr", "ndcg_at_k",
        "correct_version_recall_at_k", "exact_term_recall_at_k",
        "acl_filtered_recall_at_k", "no_answer_accuracy", "acl_leak_rate",
        "acl_leak_count", "acl_leak_case_count"
      ],
      "properties": {
        "case_count": { "type": "integer", "minimum": 1 },
        "positive_case_count": { "type": "integer", "minimum": 0 },
        "no_answer_case_count": { "type": "integer", "minimum": 0 },
        "exact_term_case_count": { "type": "integer", "minimum": 0 },
        "acl_positive_case_count": { "type": "integer", "minimum": 0 },
        "acl_denied_case_count": { "type": "integer", "minimum": 0 },
        "recall_at_k": { "$ref": "#/$defs/ratio" },
        "mrr": { "$ref": "#/$defs/ratio" },
        "ndcg_at_k": { "$ref": "#/$defs/ratio" },
        "correct_version_recall_at_k": { "$ref": "#/$defs/ratio" },
        "exact_term_recall_at_k": { "$ref": "#/$defs/ratio" },
        "acl_filtered_recall_at_k": { "$ref": "#/$defs/ratio" },
        "no_answer_accuracy": { "$ref": "#/$defs/ratio" },
        "acl_leak_rate": { "$ref": "#/$defs/ratio" },
        "acl_leak_count": { "type": "integer", "minimum": 0 },
        "acl_leak_case_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "quality_gates": {
      "type": "object",
      "required": [
        "passed", "mrr", "correct_version_recall", "exact_term_recall",
        "acl_filtered_recall", "no_answer_accuracy", "acl_leak_rate"
      ],
      "properties": {
        "passed": { "type": "boolean" },
        "mrr": { "type": "boolean" },
        "correct_version_recall": { "type": "boolean" },
        "exact_term_recall": { "type": "boolean" },
        "acl_filtered_recall": { "type": "boolean" },
        "no_answer_accuracy": { "type": "boolean" },
        "acl_leak_rate": { "type": "boolean" }
      },
      "patternProperties": {
        "^recall_at_[1-9][0-9]*$": { "type": "boolean" },
        "^ndcg_at_[1-9][0-9]*$": { "type": "boolean" }
      },
      "minProperties": 9,
      "additionalProperties": false
    },
    "case_evaluation": {
      "type": "object",
      "required": [
        "case_id", "split", "category", "answerable",
        "returned_chunk_ids", "returned_scores", "first_gold_rank",
        "gold_hit_count", "no_answer_correct", "acl_leak_document_ids",
        "candidate_count", "threshold_suppressed_count",
        "context_truncated_count"
      ],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "split": { "enum": ["calibration", "test"] },
        "category": {
          "enum": ["semantic", "exact_term", "acl", "no_answer", "multi_chunk"]
        },
        "answerable": { "type": "boolean" },
        "returned_chunk_ids": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "returned_scores": {
          "type": "array",
          "items": { "type": "number" }
        },
        "first_gold_rank": { "type": ["integer", "null"], "minimum": 1 },
        "gold_hit_count": { "type": "integer", "minimum": 0 },
        "no_answer_correct": { "type": ["boolean", "null"] },
        "acl_leak_document_ids": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "candidate_count": { "type": "integer", "minimum": 0 },
        "threshold_suppressed_count": { "type": "integer", "minimum": 0 },
        "context_truncated_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "required": ["metrics", "cases"],
      "properties": {
        "metrics": { "$ref": "#/$defs/metrics" },
        "cases": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/case_evaluation" }
        }
      },
      "additionalProperties": false
    },
    "evaluation_with_gates": {
      "type": "object",
      "required": ["metrics", "cases", "quality_gates"],
      "properties": {
        "metrics": { "$ref": "#/$defs/metrics" },
        "cases": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/case_evaluation" }
        },
        "quality_gates": { "$ref": "#/$defs/quality_gates" }
      },
      "additionalProperties": false
    },
    "threshold_calibration": {
      "type": "object",
      "required": [
        "split", "selected_candidate_k", "selected_context_k",
        "selected_score_threshold", "k_pair_count",
        "score_threshold_candidate_count", "evaluated_configuration_count",
        "quality_gates", "all_quality_gates_passed", "metrics"
      ],
      "properties": {
        "split": { "const": "calibration" },
        "selected_candidate_k": { "type": "integer", "minimum": 1 },
        "selected_context_k": { "type": "integer", "minimum": 1 },
        "selected_score_threshold": { "type": ["number", "null"] },
        "k_pair_count": { "type": "integer", "minimum": 1 },
        "score_threshold_candidate_count": { "type": "integer", "minimum": 1 },
        "evaluated_configuration_count": { "type": "integer", "minimum": 1 },
        "quality_gates": { "$ref": "#/$defs/quality_gates" },
        "all_quality_gates_passed": { "type": "boolean" },
        "metrics": { "$ref": "#/$defs/metrics" }
      },
      "additionalProperties": false
    },
    "selected_configuration_replay": {
      "type": "object",
      "required": ["passed", "mismatched_case_ids", "labels_used_for_selection"],
      "properties": {
        "passed": { "type": "boolean" },
        "mismatched_case_ids": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "labels_used_for_selection": { "const": false }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["sample_count", "total", "mean", "p50", "p95", "max"],
      "properties": {
        "sample_count": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "mean": { "$ref": "#/$defs/nonnegative_number" },
        "p50": { "$ref": "#/$defs/nonnegative_number" },
        "p95": { "$ref": "#/$defs/nonnegative_number" },
        "max": { "$ref": "#/$defs/nonnegative_number" }
      },
      "additionalProperties": false
    },
    "count_summary": {
      "type": "object",
      "required": ["configured_k", "sample_count", "total", "mean", "p50", "p95", "max"],
      "properties": {
        "configured_k": { "type": "integer", "minimum": 1 },
        "sample_count": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "mean": { "$ref": "#/$defs/nonnegative_number" },
        "p50": { "$ref": "#/$defs/nonnegative_number" },
        "p95": { "$ref": "#/$defs/nonnegative_number" },
        "max": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "costs": {
      "type": "object",
      "required": [
        "scope", "raw_candidate_pool", "selected_candidate_pool",
        "selected_context", "query_latency_ms",
        "selected_configuration_query_latency_ms"
      ],
      "properties": {
        "scope": { "const": "raw_calibration_pool_plus_optional_selected_configuration_replay" },
        "raw_candidate_pool": { "$ref": "#/$defs/count_summary" },
        "selected_candidate_pool": { "$ref": "#/$defs/count_summary" },
        "selected_context": { "$ref": "#/$defs/selected_context_summary" },
        "query_latency_ms": {
          "type": "object",
          "required": ["scope", "configured_candidate_k", "sample_count", "total", "mean", "p50", "p95", "max"],
          "properties": {
            "scope": { "const": "raw_candidate_k_embedding_plus_acl_filtered_qdrant_search" },
            "configured_candidate_k": { "type": "integer", "minimum": 1 },
            "sample_count": { "type": "integer", "minimum": 0 },
            "total": { "$ref": "#/$defs/nonnegative_number" },
            "mean": { "$ref": "#/$defs/nonnegative_number" },
            "p50": { "$ref": "#/$defs/nonnegative_number" },
            "p95": { "$ref": "#/$defs/nonnegative_number" },
            "max": { "$ref": "#/$defs/nonnegative_number" }
          },
          "additionalProperties": false
        },
        "selected_configuration_query_latency_ms": {
          "type": "object",
          "required": ["scope", "configured_candidate_k", "sample_count", "total", "mean", "p50", "p95", "max"],
          "properties": {
            "scope": { "const": "selected_candidate_k_embedding_plus_acl_filtered_qdrant_search" },
            "configured_candidate_k": { "type": "integer", "minimum": 1 },
            "sample_count": { "type": "integer", "minimum": 0 },
            "total": { "$ref": "#/$defs/nonnegative_number" },
            "mean": { "$ref": "#/$defs/nonnegative_number" },
            "p50": { "$ref": "#/$defs/nonnegative_number" },
            "p95": { "$ref": "#/$defs/nonnegative_number" },
            "max": { "$ref": "#/$defs/nonnegative_number" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "selected_context_summary": {
      "type": "object",
      "required": [
        "configured_k", "sample_count", "total", "mean", "p50", "p95", "max",
        "character_count", "threshold_suppressed_total", "context_truncated_total"
      ],
      "properties": {
        "configured_k": { "type": "integer", "minimum": 1 },
        "sample_count": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "mean": { "$ref": "#/$defs/nonnegative_number" },
        "p50": { "$ref": "#/$defs/nonnegative_number" },
        "p95": { "$ref": "#/$defs/nonnegative_number" },
        "max": { "$ref": "#/$defs/nonnegative_number" },
        "character_count": { "$ref": "#/$defs/summary" },
        "threshold_suppressed_total": { "type": "integer", "minimum": 0 },
        "context_truncated_total": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
