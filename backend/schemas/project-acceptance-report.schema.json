{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rag-kb.local/schemas/project-acceptance-report.schema.json",
  "title": "Project machine-readable acceptance report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_on", "code", "dataset", "samples", "outcomes", "model", "tool", "security", "quality", "gates", "failures", "evidence_artifacts", "report_hash", "verdict"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_on": {"type": "string", "format": "date-time"},
    "code": {"$ref": "#/$defs/status_object"},
    "dataset": {"$ref": "#/$defs/status_object"},
    "config": {"$ref": "#/$defs/status_object"},
    "samples": {"$ref": "#/$defs/status_object"},
    "outcomes": {"$ref": "#/$defs/status_object"},
    "model": {"$ref": "#/$defs/status_object"},
    "tool": {"$ref": "#/$defs/status_object"},
    "m2": {"$ref": "#/$defs/status_object"},
    "latency": {"$ref": "#/$defs/status_object"},
    "security": {"$ref": "#/$defs/status_object"},
    "quality": {"$ref": "#/$defs/status_object"},
    "cost": {"$ref": "#/$defs/status_object"},
    "gates": {"type": "array", "items": {"$ref": "#/$defs/gate"}},
    "failures": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "evidence_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "report_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verdict": {"type": "object", "required": ["status", "reason"], "additionalProperties": false, "properties": {"status": {"enum": ["passed", "failed", "unverified"]}, "reason": {"type": "string"}}}
  },
  "$defs": {
    "status_object": {
      "type": "object",
      "required": ["status", "values"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["passed", "failed", "skipped", "unverified"]},
        "values": {"type": "object", "additionalProperties": true},
        "source": {"type": ["string", "null"]}
      }
    },
    "gate": {
      "type": "object",
      "required": ["name", "status", "evidence"],
      "additionalProperties": false,
      "properties": {"name": {"type": "string"}, "status": {"enum": ["passed", "failed", "unverified"]}, "evidence": {"type": "array", "items": {"type": "string"}}}
    },
    "artifact": {
      "type": "object",
      "required": ["name", "path", "sha256", "status"],
      "additionalProperties": false,
      "properties": {"name": {"type": "string"}, "path": {"type": "string"}, "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "status": {"enum": ["available", "missing", "unverified"]}}
    }
  }
}
