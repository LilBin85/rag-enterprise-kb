{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/retrieval-acceptance-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "description", "corpus_manifest", "required_top_k", "cases"],
  "properties": {
    "version": {"const": 2},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "corpus_manifest": {"type": "string", "minLength": 1},
    "required_top_k": {"const": 5},
    "cases": {"type": "array", "minItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "version": {
      "type": "object", "additionalProperties": false,
      "required": ["document_id", "version"],
      "properties": {"document_id": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1}}
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "split", "category", "query", "role", "answerable", "gold_chunk_ids", "gold_versions", "exact_terms", "acl_filtered", "forbidden_document_ids"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "split": {"enum": ["development", "calibration", "test"]},
        "category": {"enum": ["semantic", "exact_term", "acl", "no_answer", "multi_chunk"]},
        "query": {"type": "string", "minLength": 4, "maxLength": 500},
        "role": {"enum": ["employee", "engineer", "hr", "admin"]},
        "answerable": {"type": "boolean"},
        "no_answer_kind": {"enum": ["out_of_scope", "acl_denied"]},
        "gold_chunk_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+:v[1-9][0-9]*:chunk-[0-9]{2,}$"}},
        "gold_versions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/version"}},
        "exact_terms": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "acl_filtered": {"type": "boolean"},
        "forbidden_document_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {"if": {"properties": {"answerable": {"const": true}}}, "then": {"properties": {"gold_chunk_ids": {"minItems": 1}, "gold_versions": {"minItems": 1}}, "not": {"required": ["no_answer_kind"]}}, "else": {"required": ["no_answer_kind"], "properties": {"gold_chunk_ids": {"maxItems": 0}, "gold_versions": {"maxItems": 0}}}},
        {"if": {"properties": {"category": {"const": "exact_term"}}}, "then": {"properties": {"exact_terms": {"minItems": 1}}}},
        {"if": {"properties": {"category": {"const": "multi_chunk"}}}, "then": {"properties": {"gold_chunk_ids": {"minItems": 2}}}},
        {"if": {"properties": {"category": {"const": "acl"}}}, "then": {"properties": {"acl_filtered": {"const": true}}}},
        {"if": {"required": ["no_answer_kind"], "properties": {"no_answer_kind": {"const": "acl_denied"}}}, "then": {"properties": {"forbidden_document_ids": {"minItems": 1}}}}
      ]
    }
  }
}
